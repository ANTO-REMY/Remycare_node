generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  password  String
  role      String   // 'mother' | 'chw' | 'nurse' | 'admin'
  name      String
  email     String?
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mother    Mother?
  chw       CHW?
  nurse     Nurse?
  sessions  Session[]
}

model Mother {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [id], references: [id])
  dueDate        DateTime?
  pregnancyWeek  Int?
  postpartumWeek Int?
  assignedChwId  String?
  assignedChw    CHW?     @relation("CHWMothers", fields: [assignedChwId], references: [id])
  lastCheckIn    DateTime?
  status         String   // 'ok' | 'not_ok' | 'no_response'
  medicalHistory String?
  emergencyContact String?
}

model CHW {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [id], references: [id])
  mothers    Mother[] @relation("CHWMothers")
  certificationNumber String?
  maxMothersCapacity  Int      @default(50)
  specializations     String?
}

model Nurse {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [id], references: [id])
  licenseNumber String?
  department     String?
}

model Session {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  refreshToken String
  deviceInfo  String?
  ipAddress   String?
  isActive    Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsed    DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  oldValues    String?
  newValues    String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}
